{
	"name": "test-pair",
	"displayName": "TestPair",
	"publisher": "absszero",
	"description": "Pair your source/test files from test/source files.",
	"version": "1.2.0",
	"repository": "https://github.com/absszero/vscode-test-pair",
	"engines": {
		"vscode": "^1.76.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"test",
		"testing",
		"file",
		"source"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "extension.test-pair",
				"title": "TestPair: Pair the Source/Test file"
			}
		],
		"keybindings": [
			{
				"command": "extension.test-pair",
				"key": "shift+ctrl+p",
				"when": "editorTextFocus"
			}
		],
		"configuration": [
			{
				"title": "TestPair",
				"properties": {
					"testPair.exclusion": {
						"description": "the glob pattern to exclude pair files.",
						"scope": "window",
						"type": "string",
						"default": "**/{node_modules,vendor}/"
					},
					"testPair.rules": {
						"description": "Specifies pair rules",
						"scope": "window",
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"extension": {
									"type": "string",
									"description": "the file extension."
								},
								"testGlob": {
									"type": "string",
									"description": "the glob pattern for test filenames, @@ as source filename."
								},
								"sourceGlob": {
									"type": "string",
									"description": "the glob pattern for source filenames, @@ as source filename."
								},
								"sourceExt": {
									"type": "string",
									"description": "the glob pattern for source file extensions. if ignore it, default is current file extension."
								}
							}
						},
						"default": [
							{
								"extension": "php",
								"testGlob": "@@Test.php",
								"sourceGlob": "@@{Test}"
							},
							{
								"extension": "py",
								"testGlob": "test_@@.py",
								"sourceGlob": "{test_}@@"
							},
							{
								"extension": "java",
								"testGlob": "@@Test.java",
								"sourceGlob": "@@{Test}"
							},
							{
								"extension": "kt",
								"testGlob": "@@Test.kt",
								"sourceGlob": "@@{Test}"
							},
							{
								"extension": "groovy",
								"testGlob": "@@{Test,Spec}.groovy",
								"sourceGlob": "@@{Test,Spec}"
							},
							{
								"extension": "js",
								"testGlob": "@@{.spec,.test}.{ts,js}",
								"sourceGlob": "@@{.spec,.test}",
								"sourceExt": "{js,vue,jsx,tsx}"
							},
							{
								"extension": "ts",
								"testGlob": "@@{.spec,.test}.ts",
								"sourceGlob": "@@{.spec,.test}",
								"sourceExt": "{ts,vue,jsx,tsx}"
							},
							{
								"extension": "vue",
								"testGlob": "@@{.spec,.test}.{ts,js}"
							},
							{
								"extension": "jsx",
								"testGlob": "@@{.spec,.test}.{ts,js}"
							},
							{
								"extension": "rb",
								"testGlob": "@@{_spec,_test}.rb",
								"sourceGlob": "@@{_spec,_test}"
							},
							{
								"extension": "go",
								"testGlob": "@@_test.go",
								"sourceGlob": "@@{_test}"
							},
							{
								"extension": "swift",
								"testGlob": "@@Tests.swift",
								"sourceGlob": "@@{Tests}"
							},
							{
								"extension": "m",
								"testGlob": "@@Test.m",
								"sourceGlob": "@@{Test}"
							},
							{
								"extension": "r",
								"testGlob": "test_@@.r",
								"sourceGlob": "{test_}@@"
							}
						]
					}
				}
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run esbuild-base -- --minify",
		"esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
		"esbuild": "npm run esbuild-base -- --sourcemap",
		"esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile",
		"lint": "eslint src",
		"test": "node ./out/test/runTest.js"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "^3.1.0",
		"@types/vscode": "^1.76.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "20.x",
		"eslint": "^9.19.0",
		"@typescript-eslint/eslint-plugin": "^8.22.0",
		"@typescript-eslint/parser": "^8.22.0",
		"glob": "^13.0.6",
		"mocha": "^11.7.5",
		"typescript": "5.5",
		"@vscode/test-electron": "^2.3.9"
	},
	"dependencies": {
		"minimatch": "^10.2.5"
	}
}
